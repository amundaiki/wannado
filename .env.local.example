# Sanity CMS
NEXT_PUBLIC_SANITY_DATASET="production"
NEXT_PUBLIC_SANITY_PROJECT_ID="your-project-id"

# Embedded Sanity Studio protection in production
STUDIO_BASIC_AUTH_USER=""
STUDIO_BASIC_AUTH_PASSWORD=""

# Contact form email delivery
RESEND_API_KEY=""

# Required in production for contact form rate limiting.
# Set true only when the host/proxy overwrites or strips incoming client IP headers.
CONTACT_TRUST_PROXY_HEADERS="false"

# Optional content import and media generation scripts
APIFY_API_KEY=""
GOOGLE_API_KEY=""

# Optional analytics, normally enabled by Vercel automatically with VERCEL=1
NEXT_PUBLIC_ENABLE_VERCEL_ANALYTICS="false"
